{
  "name": "@codepress/brand-kit",
  "version": "0.1.0",
  "description": "Brand mechanics for React sites: turn a firm's identity into CSS variables, grain, motif patterns, frames, icons and motion that respect reduced motion",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./identity.schema.json": "./identity.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "identity.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run src",
    "size": "node scripts/size.mjs",
    "lint": "oxlint --ignore-pattern 'dist/**' .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "happy-dom": "^20.8.9",
    "oxlint": "^1.51.0",
    "prettier": "^3.8.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "brand",
    "design-tokens",
    "css-variables",
    "react",
    "grain",
    "reduced-motion"
  ],
  "author": "CodePress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codepressdev/brand-kit.git"
  },
  "homepage": "https://github.com/codepressdev/brand-kit#readme",
  "bugs": {
    "url": "https://github.com/codepressdev/brand-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
